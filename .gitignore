# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# --- DomifyTool ---

# Herramientas de IA: la config compartida del equipo sí se versiona
# (.claude/settings.json), los ajustes locales de cada máquina no.
.claude/settings.local.json
.qodo/

# Configuración de entorno (--dart-define-from-file).
# El valor cambia por máquina: 10.0.2.2 en el emulador de Android, localhost
# en el simulador de iOS, IP de la LAN en un móvil físico. Por eso se versiona
# la plantilla y no el archivo real.
config/*.json
!config/*.example.json

.env
.env.*

# Cobertura
coverage/
